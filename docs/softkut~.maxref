<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>

<c74object name='softkut~' module='msp' category='MSP Sampling'>

	<digest>
		softcut-lib buffer looper
	</digest>

	<description>
		softkut~ wraps monome's softcut-lib (the norns looping engine). It provides 1-6 voices
		that read and write a shared (or per-voice) buffer~, with sub-sample looping, crossfaded
		overdub, resampling read/write heads, per-voice input and output multimode filters,
		per-voice output level, and inlet-to-voice and voice-to-voice routing matrices. Most
		messages address a single voice as &lt;voice&gt;, counted from 1; times are in ms of
		buffer material. Any buffer~ works: any length, any channel count (each voice uses one
		channel), and its own sample rate (rate 1 plays at recorded speed).
	</description>


	<!--METADATA-->

	<metadatalist>
		<metadata name='author'>Shakeeb Alireza</metadata>
		<metadata name='tag'>MSP</metadata>
		<metadata name='tag'>MSP Sampling</metadata>
		<metadata name='tag'>softcut</metadata>
	</metadatalist>


	<!--INLETS-->

	<inletlist>
		<inlet id="0" type="signal">
			<digest>Voice 1 record input / control messages</digest>
			<description>
				Signal record input for voice 1. All control messages go to this (left) inlet. There
				is one record-input inlet per voice: inlet n is voice n + 1.
			</description>
		</inlet>
	</inletlist>


	<!--OUTLETS-->

	<outletlist>
		<outlet id="0" type="signal">
			<digest>Voice 1 output</digest>
			<description>
				Voice 1 playback (post level). With N voices, outlets 0 to N - 1 are the voices'
				audio.
			</description>
		</outlet>
		<outlet id="1" type="signal">
			<digest>Voice 1 sync (play head, ms)</digest>
			<description>
				Voice 1's play head as a signal, in ms of buffer material, wrapped to the buffer's
				length, like groove~'s sync outlet. With N voices, outlets N to 2N - 1 are the
				voices' sync signals. Use snapshot~ to drive a waveform~ cursor.
			</description>
		</outlet>
		<outlet id="2" type="list">
			<digest>Reports</digest>
			<description>
				The rightmost outlet. Sends "phase &lt;voice&gt; &lt;ms&gt;" every @report ms for each
				voice whose position changed, and one "info &lt;voice&gt; &lt;pos&gt; &lt;play&gt;
				&lt;rec&gt; &lt;start&gt; &lt;end&gt; &lt;window&gt; &lt;state&gt; &lt;position&gt;"
				list per voice on poll: pos is 0-1 within the loop window, the times are ms, and
				state is 0 stopped, 1 playing, 2 recording, 3 overdub. Ports shown are for one voice.
			</description>
		</outlet>
	</outletlist>


	<!--ARGUMENTS-->

	<objarglist>
		<objarg name="buffer-name" optional="1" type="symbol">
			<digest>Name of the shared buffer~</digest>
			<description>
				Sets the buffer~ that all voices read and write; voice v uses channel v, wrapping
				when there are more voices than channels. Can be changed later with
				the set message, or overridden per voice with voicebuf.
			</description>
		</objarg>
		<objarg name="channels" optional="1" type="int">
			<digest>Voice count (default 1, max 6)</digest>
			<description>
				Number of voices: one record inlet, one audio outlet and one sync outlet per voice.
				Defaults to 1; clamped to the range 1-6.
			</description>
		</objarg>
	</objarglist>


	<!--MESSAGES-->

	<methodlist>

		<method name="play">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Enable/disable playback for a voice</digest>
			<description>1 starts reading (playback) for the voice; 0 stops it.</description>
		</method>

		<method name="rec">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Enable/disable recording for a voice</digest>
			<description>1 starts writing (recording) into the buffer for the voice; 0 stops it.</description>
		</method>

		<method name="reconce">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Record a single loop pass</digest>
			<description>When set, the voice records one loop pass then auto-clears its record flag.</description>
		</method>

		<method name="stop">
			<arglist>
				<arg name="voice" type="int" optional="0" />
			</arglist>
			<digest>Immediately park a voice's heads</digest>
			<description>Hard-stops both subheads (silent), distinct from play 0 which fades the transport.</description>
		</method>

		<method name="position">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Jump the play head to a position</digest>
			<description>Cuts the voice's play head to the given position in ms within the buffer.</description>
		</method>

		<method name="enable">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Master on/off gate for a voice</digest>
			<description>
				When off (0), the voice is skipped entirely: no audio output, no recording, and no
				feedback contribution. Default is on.
			</description>
		</method>

		<method name="rate">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ratio" type="float" optional="0" />
			</arglist>
			<digest>Set playback/record rate</digest>
			<description>1 = normal, 0.5 = half speed (octave down), 2 = double, negative = reverse.</description>
		</method>

		<method name="loopstart">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set loop start point (ms)</digest>
			<description>Loop start position in ms.</description>
		</method>

		<method name="loopend">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set loop end point (ms)</digest>
			<description>Loop end position in ms.</description>
		</method>

		<method name="loop">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Set loop flag</digest>
			<description>1 loops; 0 plays one-shot and stops at the loop end.</description>
		</method>

		<method name="fade">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set loop/record crossfade time</digest>
			<description>Crossfade time in ms for loop wrap and record transitions.</description>
		</method>

		<method name="reclevel">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amp" type="float" optional="0" />
			</arglist>
			<digest>Set record amplitude</digest>
			<description>How much of the input is written into the buffer.</description>
		</method>

		<method name="prelevel">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amp" type="float" optional="0" />
			</arglist>
			<digest>Set overdub preserve level</digest>
			<description>0 overwrites existing content; 1 preserves it fully (overdub); in between, decaying overdub.</description>
		</method>

		<method name="recoffset">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set record-head offset</digest>
			<description>Offset of the record head relative to the play head, in ms (default approximately -8 samples).</description>
		</method>

		<method name="prefc">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="hz" type="float" optional="0" />
			</arglist>
			<digest>Input filter cutoff (Hz)</digest>
			<description>Cutoff frequency of the pre-filter (applied to the record input).</description>
		</method>

		<method name="prerq">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="rq" type="float" optional="0" />
			</arglist>
			<digest>Input filter reciprocal Q</digest>
			<description>Reciprocal Q (resonance) of the pre-filter; smaller values are more resonant.</description>
		</method>

		<method name="prelp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Input filter low-pass mix</digest>
			<description>Low-pass output mix of the pre-filter.</description>
		</method>

		<method name="prehp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Input filter high-pass mix</digest>
			<description>High-pass output mix of the pre-filter.</description>
		</method>

		<method name="prebp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Input filter band-pass mix</digest>
			<description>Band-pass output mix of the pre-filter.</description>
		</method>

		<method name="prebr">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Input filter band-reject mix</digest>
			<description>Band-reject (notch) output mix of the pre-filter.</description>
		</method>

		<method name="predry">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amp" type="float" optional="0" />
			</arglist>
			<digest>Input filter dry mix</digest>
			<description>Dry (unfiltered) input mix added to the pre-filter output.</description>
		</method>

		<method name="prefcmod">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amount" type="float" optional="0" />
			</arglist>
			<digest>Input filter cutoff rate-tracking</digest>
			<description>How much the pre-filter cutoff tracks the playback rate.</description>
		</method>

		<method name="postfc">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="hz" type="float" optional="0" />
			</arglist>
			<digest>Output filter cutoff (Hz)</digest>
			<description>Cutoff frequency of the post-filter (applied to playback).</description>
		</method>

		<method name="postrq">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="rq" type="float" optional="0" />
			</arglist>
			<digest>Output filter reciprocal Q</digest>
			<description>Reciprocal Q (resonance) of the post-filter; smaller values are more resonant.</description>
		</method>

		<method name="postlp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Output filter low-pass mix</digest>
			<description>Low-pass output mix of the post-filter.</description>
		</method>

		<method name="posthp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Output filter high-pass mix</digest>
			<description>High-pass output mix of the post-filter.</description>
		</method>

		<method name="postbp">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Output filter band-pass mix</digest>
			<description>Band-pass output mix of the post-filter.</description>
		</method>

		<method name="postbr">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="mix" type="float" optional="0" />
			</arglist>
			<digest>Output filter band-reject mix</digest>
			<description>Band-reject (notch) output mix of the post-filter.</description>
		</method>

		<method name="postdry">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amp" type="float" optional="0" />
			</arglist>
			<digest>Output filter dry mix</digest>
			<description>Dry (unfiltered) playback mix added to the post-filter output.</description>
		</method>

		<method name="level">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="amp" type="float" optional="0" />
			</arglist>
			<digest>Set voice output level</digest>
			<description>Voice output gain. Smoothed.</description>
		</method>

		<method name="pan">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="position" type="float" optional="0" />
			</arglist>
			<digest>Set voice pan (no effect)</digest>
			<description>Accepted for compatibility but has no effect: there is no built-in stereo mix outlet. Do stereo placement downstream by routing the voice outputs yourself.</description>
		</method>

		<method name="levelslew">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set level smoothing time</digest>
			<description>Smoothing (slew) time in ms for the level message.</description>
		</method>

		<method name="panslew">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set pan smoothing time (no effect)</digest>
			<description>Accepted for compatibility but has no effect (see pan).</description>
		</method>

		<method name="recpreslew">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set record/pre level slew time</digest>
			<description>Smoothing time in ms for record and pre levels inside softcut.</description>
		</method>

		<method name="rateslew">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set rate slew time</digest>
			<description>Smoothing time in ms for rate changes.</description>
		</method>

		<method name="quant">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set phase quantization step</digest>
			<description>Reports phase in steps of this many ms; 0 (the default) is unquantized.</description>
		</method>

		<method name="phaseoffset">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Set reported phase offset</digest>
			<description>Offset in ms added to the voice's reported phase. softcut applies it only when quant is above 0.</description>
		</method>

		<method name="sync">
			<arglist>
				<arg name="follow" type="int" optional="0" />
				<arg name="lead" type="int" optional="0" />
				<arg name="offset-ms" type="float" optional="0" />
			</arglist>
			<digest>Sync one voice to another</digest>
			<description>Jumps voice follow to voice lead's current position plus offset ms. Voices count from 1.</description>
		</method>

		<method name="poll">
			<digest>Report each voice's state</digest>
			<description>Sends one info list per voice out the report outlet (see the report outlet).</description>
		</method>

		<method name="set">
			<arglist>
				<arg name="buffer-name" type="symbol" optional="0" />
				<arg name="channel" type="int" optional="1" />
			</arglist>
			<digest>Set the shared buffer~</digest>
			<description>Points all voices at the named buffer~. With a channel (from 1), every voice uses it; without, voice v uses channel v, wrapping.</description>
		</method>

		<method name="voicebuf">
			<arglist>
				<arg name="voice" type="int" optional="0" />
				<arg name="buffer-name" type="symbol" optional="0" />
				<arg name="channel" type="int" optional="1" />
			</arglist>
			<digest>Set one voice's buffer~</digest>
			<description>Points a single voice (from 1) at its own buffer~ and optional channel (from 1), overriding set.</description>
		</method>

		<method name="inlevel">
			<arglist>
				<arg name="inlet" type="int" optional="0" />
				<arg name="voice" type="int" optional="0" />
				<arg name="gain" type="float" optional="0" />
			</arglist>
			<digest>Route an inlet into a voice's record input</digest>
			<description>
				Input routing matrix. Routes signal inlet (from 1) into the given voice's record input at
				gain. Defaults to identity (inlet v -&gt; voice v at unity); off-diagonal entries let one
				input feed several voices.
			</description>
		</method>

		<method name="feedback">
			<arglist>
				<arg name="src" type="int" optional="0" />
				<arg name="dst" type="int" optional="0" />
				<arg name="gain" type="float" optional="0" />
			</arglist>
			<digest>Route a voice's output into another voice's record input</digest>
			<description>
				Feedback matrix. Routes voice src's output into voice dst's record input at gain (one
				block delayed). Enables overdub/looping networks; self-feedback (src equals dst) is
				allowed, so mind stability.
			</description>
		</method>

		<method name="reset">
			<digest>Reset all voices to defaults</digest>
			<description>
				Stops every voice and restores every default: rate 1, 0-1000 ms loop, looping on,
				level 1, no feedback, identity input routing. The next play starts from the loop
				start. The buffer~ assignment and @report are kept.
			</description>
		</method>

	</methodlist>


	<!--ATTRIBUTES-->

	<attributelist>

		<attribute name='report' get='1' set='1' type='int' size='1' >
			<digest>Phase report interval (ms)</digest>
			<description>
				Interval in ms at which the report outlet sends "phase &lt;voice&gt; &lt;ms&gt;" for each
				voice whose position changed. 0 (the default) disables it. Takes effect at once.
			</description>
		</attribute>

	</attributelist>


	<!--RELATED-->

	<seealsolist>
		<seealso name="buffer~"/>
		<seealso name="groove~"/>
		<seealso name="record~"/>
		<seealso name="poke~"/>
	</seealsolist>


</c74object>
