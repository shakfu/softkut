<?xml version='1.0' encoding='utf-8' standalone='yes'?>
<?xml-stylesheet href="./_c74_ref.xsl" type="text/xsl"?>

<c74object name='softkut~' module='msp' category='MSP Sampling'>

	<digest>One softcut looper voice on a buffer~</digest>

	<description>softkut~ is one voice of monome's softcut-lib, the norns looping engine. It plays and records one channel of a buffer~ with crossfaded loop points and position jumps, overdub with a pre level, resampled reads and writes at any rate, and multimode filters on the record input and on playback. Parameters are attributes; play, rec and the other transport controls are messages. Use one object per voice, or mc.softkut~. Any buffer~ works: any length, any channel count, and its own sample rate. Times are ms of buffer material.</description>

	<metadatalist>
		<metadata name='author'>Shakeeb Alireza</metadata>
		<metadata name='tag'>MSP</metadata>
		<metadata name='tag'>MSP Sampling</metadata>
		<metadata name='tag'>softcut</metadata>
	</metadatalist>

	<inletlist>
		<inlet id="0" type="signal">
			<digest>Record input, messages</digest>
			<description>The signal recorded while rec is on. Takes every message and attribute.</description>
		</inlet>
		<inlet id="1" type="signal/float">
			<digest>Rate</digest>
			<description>A signal sets the rate for every sample, in place of @rate; @rateslew still smooths it. A number sets @rate.</description>
		</inlet>
	</inletlist>

	<outletlist>
		<outlet id="0" type="signal">
			<digest>Audio</digest>
			<description>The voice's playback, after the output filter.</description>
		</outlet>
		<outlet id="1" type="signal">
			<digest>Play head</digest>
			<description>The play head for every sample: ms in the buffer~, wrapped to its length, or 0-1 across the loop with @syncmode phase. Use snapshot~ to drive a waveform~ cursor.</description>
		</outlet>
		<outlet id="2" type="list">
			<digest>info and attribute values</digest>
			<description>On poll, "info &lt;play&gt; &lt;rec&gt; &lt;state&gt; &lt;position&gt; &lt;start&gt; &lt;end&gt;": state is 0 stopped, 1 playing, 2 recording, 3 overdub; position is the play head; start and end are the loop played, so @loopend 0 reports the buffer~'s end. Times are ms. Also answers getattr messages, such as getrate, with the attribute name and value.</description>
		</outlet>
	</outletlist>

	<objarglist>
		<objarg name="buffer-name" optional="1" type="symbol">
			<digest>The buffer~</digest>
			<description>Sets @buffer. Further plain arguments are ignored with a warning: use one object per voice.</description>
		</objarg>
	</objarglist>

	<methodlist>
		<method name="play">
			<arglist>
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Start or stop playback</digest>
			<description>1 starts playback, 0 stops it. Playback starts inside the loop.</description>
		</method>
		<method name="rec">
			<arglist>
				<arg name="flag" type="int" optional="0" />
			</arglist>
			<digest>Start or stop recording</digest>
			<description>1 starts writing the record input into the buffer~, 0 stops it.</description>
		</method>
		<method name="reconce">
			<digest>Record one loop pass</digest>
			<description>Records one pass, from the next loop start or position jump, then stops recording.</description>
		</method>
		<method name="stop">
			<digest>Stop playback and recording</digest>
			<description>Equivalent to play 0 and rec 0, applied in the same signal vector.</description>
		</method>
		<method name="position">
			<arglist>
				<arg name="ms" type="float" optional="0" />
			</arglist>
			<digest>Jump the play head</digest>
			<description>Jumps the play head to a position in ms of buffer material, with a crossfade (@fade).</description>
		</method>
		<method name="set">
			<arglist>
				<arg name="buffer-name" type="symbol" optional="0" />
				<arg name="channel" type="int" optional="1" />
			</arglist>
			<digest>Set the buffer~</digest>
			<description>Sets @buffer, and @channel if given.</description>
		</method>
		<method name="poll">
			<digest>Report the voice's state</digest>
			<description>Sends info out the right outlet (see the outlet).</description>
		</method>
		<method name="reset">
			<digest>Restore the defaults</digest>
			<description>Stops the voice and restores every attribute default. @buffer and @channel are kept.</description>
		</method>
		<method name="signal">
			<digest>Record input, or rate</digest>
			<description>Left inlet: the record input. Right inlet: the rate, per sample, in place of @rate.</description>
		</method>
		<method name="float">
			<arglist>
				<arg name="rate" type="float" optional="0" />
			</arglist>
			<digest>Set the rate</digest>
			<description>In the right inlet, sets @rate. The left inlet takes no numbers.</description>
		</method>
		<method name="int">
			<arglist>
				<arg name="rate" type="int" optional="0" />
			</arglist>
			<digest>Set the rate</digest>
			<description>In the right inlet, sets @rate.</description>
		</method>
	</methodlist>

	<attributelist>
		<attribute name='buffer' get='1' set='1' type='symbol' size='1' >
			<digest>The buffer~</digest>
			<description>The buffer~ the voice reads and writes. Also set by the first argument or the set message.</description>
		</attribute>
		<attribute name='channel' get='1' set='1' type='int' size='1' >
			<digest>buffer~ channel</digest>
			<description>The channel of the buffer~ the voice reads and writes, counted from 1. Default 1. A channel the buffer~ lacks silences the voice, with one console warning.</description>
		</attribute>
		<attribute name='syncmode' get='1' set='1' type='int' size='1' >
			<digest>Play head output</digest>
			<description>What the middle outlet carries: ms (0, the default), the play head in ms of the buffer~, wrapped to its length; or phase (1), 0-1 across the loop.</description>
		</attribute>
		<attribute name='rate' get='1' set='1' type='float64' size='1' >
			<digest>Playback and record rate</digest>
			<description>1 is the buffer~'s recorded speed, 0.5 an octave down, 2 an octave up, negative reverse. Range -64 to 64. Ignored while the right inlet has a signal. Default 1.</description>
		</attribute>
		<attribute name='rateslew' get='1' set='1' type='float64' size='1' >
			<digest>Rate smoothing (ms)</digest>
			<description>Smoothing time for rate changes, including the rate signal. Set 0 for audio-rate modulation. Default 1.</description>
		</attribute>
		<attribute name='loopstart' get='1' set='1' type='float64' size='1' >
			<digest>Loop start (ms)</digest>
			<description>Loop start in ms of buffer material. Default 0.</description>
		</attribute>
		<attribute name='loopend' get='1' set='1' type='float64' size='1' >
			<digest>Loop end (ms)</digest>
			<description>Loop end in ms of buffer material. 0 (the default) is the buffer~'s end, and follows the buffer~ when it is resized. A loop end past the buffer~'s end wraps to its start.</description>
		</attribute>
		<attribute name='loop' get='1' set='1' type='int' size='1' >
			<digest>Loop on/off</digest>
			<description>1 (the default) loops; 0 plays one-shot and stops at the loop end.</description>
		</attribute>
		<attribute name='fade' get='1' set='1' type='float64' size='1' >
			<digest>Crossfade time (ms)</digest>
			<description>Crossfade time for the loop wrap and for position jumps. Default 10.</description>
		</attribute>
		<attribute name='reclevel' get='1' set='1' type='float64' size='1' >
			<digest>Record level</digest>
			<description>How much of the input is written, 0-1. Default 1.</description>
		</attribute>
		<attribute name='prelevel' get='1' set='1' type='float64' size='1' >
			<digest>Pre level</digest>
			<description>How much existing content is kept on each pass, 0-1: 0 (the default) overwrites, 1 sums on top, between decays.</description>
		</attribute>
		<attribute name='recpreslew' get='1' set='1' type='float64' size='1' >
			<digest>Record and pre level smoothing (ms)</digest>
			<description>Smoothing time for reclevel and prelevel. Default 1.</description>
		</attribute>
		<attribute name='recoffset' get='1' set='1' type='int' size='1' >
			<digest>Record head offset (samples)</digest>
			<description>Offset of the record head from the play head, in samples of buffer material. Default -8.</description>
		</attribute>
		<attribute name='recshape' get='1' set='1' type='int' size='1' >
			<digest>Record fade shape</digest>
			<description>Curve of the record level during crossfades: linear (0, the default), sine (1) or raised (2). raised is softcut's default and stores the input inverted.</description>
		</attribute>
		<attribute name='preshape' get='1' set='1' type='int' size='1' >
			<digest>Pre fade shape</digest>
			<description>Curve of the pre level during crossfades: linear (0, the default), sine (1) or raised (2).</description>
		</attribute>
		<attribute name='softclip' get='1' set='1' type='int' size='1' >
			<digest>Soft clip on/off</digest>
			<description>1 applies softcut's soft clip to the record input: 1.2x gain below its knee, saturating above. 0 (the default) records the input unchanged. Stored samples are bounded to +/-32 either way.</description>
		</attribute>
		<attribute name='prefc' get='1' set='1' type='float64' size='1' >
			<digest>Input filter cutoff (Hz)</digest>
			<description>Cutoff of the multimode filter on the record input. At least 10 Hz; softcut caps it at 0.4 times the sample rate. Default 16000.</description>
		</attribute>
		<attribute name='prerq' get='1' set='1' type='float64' size='1' >
			<digest>Input filter reciprocal Q</digest>
			<description>Reciprocal Q of the input filter, at least 0.01; smaller is more resonant. Default 4.</description>
		</attribute>
		<attribute name='prelp' get='1' set='1' type='float64' size='1' >
			<digest>Input filter low-pass mix</digest>
			<description>Low-pass output of the input filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='prehp' get='1' set='1' type='float64' size='1' >
			<digest>Input filter high-pass mix</digest>
			<description>High-pass output of the input filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='prebp' get='1' set='1' type='float64' size='1' >
			<digest>Input filter band-pass mix</digest>
			<description>Band-pass output of the input filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='prebr' get='1' set='1' type='float64' size='1' >
			<digest>Input filter band-reject mix</digest>
			<description>Band-reject output of the input filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='predry' get='1' set='1' type='float64' size='1' >
			<digest>Input filter dry mix</digest>
			<description>Unfiltered input, 0-1. Default 1: the input is recorded unfiltered.</description>
		</attribute>
		<attribute name='prefcmod' get='1' set='1' type='float64' size='1' >
			<digest>Input filter rate tracking</digest>
			<description>How far the input filter cutoff follows the rate, 0-1. Default 1.</description>
		</attribute>
		<attribute name='postfc' get='1' set='1' type='float64' size='1' >
			<digest>Output filter cutoff (Hz)</digest>
			<description>Cutoff of the multimode filter on playback. At least 10 Hz. Default 12000.</description>
		</attribute>
		<attribute name='postrq' get='1' set='1' type='float64' size='1' >
			<digest>Output filter reciprocal Q</digest>
			<description>Reciprocal Q of the output filter, at least 0.01. Default 4.</description>
		</attribute>
		<attribute name='postlp' get='1' set='1' type='float64' size='1' >
			<digest>Output filter low-pass mix</digest>
			<description>Low-pass output of the output filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='posthp' get='1' set='1' type='float64' size='1' >
			<digest>Output filter high-pass mix</digest>
			<description>High-pass output of the output filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='postbp' get='1' set='1' type='float64' size='1' >
			<digest>Output filter band-pass mix</digest>
			<description>Band-pass output of the output filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='postbr' get='1' set='1' type='float64' size='1' >
			<digest>Output filter band-reject mix</digest>
			<description>Band-reject output of the output filter, 0-1. Default 0.</description>
		</attribute>
		<attribute name='postdry' get='1' set='1' type='float64' size='1' >
			<digest>Output filter dry mix</digest>
			<description>Unfiltered playback, 0-1. Default 1.</description>
		</attribute>
	</attributelist>

	<seealsolist>
		<seealso name="buffer~"/>
		<seealso name="groove~"/>
		<seealso name="record~"/>
		<seealso name="poke~"/>
		<seealso name="mc.softkut~"/>
	</seealsolist>

</c74object>
